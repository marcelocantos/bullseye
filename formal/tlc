#!/usr/bin/env bash
# Run TLC on a spec in this directory.
#
# Usage: ./tlc Spec [Config] [tlc args...]
#   ./tlc BullseyeConvergence
#   ./tlc BullseyeConvergence BullseyeConvergence-EagerRollup
#
# Finds tla2tools.jar via $TLA2TOOLS_JAR, then ./tools/, then ~/.local/lib/.
# One worker by default so output matches the recorded oracle; override
# with TLC_WORKERS. Default metadir is ./states/<config>; override with
# TLC_METADIR so concurrent runs of the same spec do not collide.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"

jar=""
for candidate in ${TLA2TOOLS_JAR+"$TLA2TOOLS_JAR"} "$here/tools/tla2tools.jar" "$HOME/.local/lib/tla2tools.jar"; do
    if [[ -n "$candidate" && -f "$candidate" ]]; then
        jar="$candidate"
        break
    fi
done
if [[ -z "$jar" ]]; then
    echo "tla2tools.jar not found: set TLA2TOOLS_JAR or place it in $here/tools/" >&2
    exit 1
fi

if [[ $# -lt 1 ]]; then
    echo "usage: $0 Spec [Config] [tlc args...]" >&2
    exit 2
fi
spec="${1%.tla}"
shift
cfg="$spec"
if [[ $# -ge 1 ]]; then
    cfg="${1%.cfg}"
    shift
fi

metadir="${TLC_METADIR:-$here/states/$cfg}"
mkdir -p "$metadir"

exec java -XX:+UseParallelGC -cp "$jar" tlc2.TLC \
    -workers "${TLC_WORKERS:-1}" \
    -metadir "$metadir" \
    -config "$here/$cfg.cfg" \
    "$here/$spec.tla" "$@"
