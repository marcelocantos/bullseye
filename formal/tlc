#!/usr/bin/env bash
# Run TLC on a spec in this directory.
#
# Usage: ./tlc Spec [Config] [tlc args...]
#   ./tlc BullseyeConvergence
#   ./tlc BullseyeConvergence BullseyeConvergence-EagerRollup
#
# Finds tla2tools.jar via $TLA2TOOLS_JAR, then ./tools/, then ~/.local/lib/.
# One worker by default so output matches the recorded oracle; override
# with TLC_WORKERS. Java: $TLC_JAVA, else macOS java_home -v 11+, else PATH.
# Default metadir is ./states/<config>; override with
# TLC_METADIR so concurrent runs of the same spec do not collide.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"

jar=""
for candidate in ${TLA2TOOLS_JAR+"$TLA2TOOLS_JAR"} "$here/tools/tla2tools.jar" "$HOME/.local/lib/tla2tools.jar"; do
    if [[ -n "$candidate" && -f "$candidate" ]]; then
        jar="$candidate"
        break
    fi
done
if [[ -z "$jar" ]]; then
    echo "tla2tools.jar not found: set TLA2TOOLS_JAR or place it in $here/tools/" >&2
    exit 1
fi

if [[ $# -lt 1 ]]; then
    echo "usage: $0 Spec [Config] [tlc args...]" >&2
    exit 2
fi
spec="${1%.tla}"
shift
cfg="$spec"
if [[ $# -ge 1 ]]; then
    cfg="${1%.cfg}"
    shift
fi

metadir="${TLC_METADIR:-$here/states/$cfg}"
mkdir -p "$metadir"

# Pick the JDK explicitly rather than trusting `java` on PATH. On this
# fleet that is usually a jenv shim, which resolves the user's *global*
# Java choice; when that entry dangles (Homebrew removed the Cellar path
# it named), every TLC run dies with "version `21' is not installed"
# and the gate reads as a model failure. TLC 2.19 needs Java 11+.
# Order: $TLC_JAVA, then macOS java_home, then `java` on PATH.
if [[ -n "${TLC_JAVA:-}" ]]; then
    java="$TLC_JAVA"
elif [[ -x /usr/libexec/java_home ]] && jhome="$(/usr/libexec/java_home -v 11+ 2>/dev/null)"; then
    java="$jhome/bin/java"
else
    java="java"
fi
if ! "$java" -version >/dev/null 2>&1; then
    echo "tlc: $java cannot start a JVM; set TLC_JAVA to a Java 11+ binary" >&2
    "$java" -version >&2 || true
    exit 1
fi

exec "$java" -XX:+UseParallelGC -cp "$jar" tlc2.TLC \
    -workers "${TLC_WORKERS:-1}" \
    -metadir "$metadir" \
    -config "$here/$cfg.cfg" \
    "$here/$spec.tla" "$@"
